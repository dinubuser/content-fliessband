# Content-Fliessband: Konfiguration (Vorlage)
#
# So richtest du es ein:
#   cp .env.example .env
#   und alle Platzhalter (your-…, example.com, @dein.konto) durch deine Werte ersetzen.
#
# Reihenfolge der Auflösung in Python: Umgebungsvariable, dann .env, dann Standard im Code.
# Die Shell-Skripte in server/ und launchd/ lesen nur die Datei .env.
# Geheimnisse gehören NICHT in diese Datei, sondern in den macOS-Schlüsselbund (siehe unten).

# === Konto ===
# Instagram-Handle für Bild-Beschriftung und Prompts
FLIESSBAND_HANDLE=@dein.konto

# === Agentur-Werkzeug (externer Textgenerator, nicht Teil dieses Repos) ===
# Ordner mit profil.md, stimme.md, learnings.md und geschichten.md
FLIESSBAND_AGENTUR_DIR=~/agentur-daten
# Skill-Ordner des Agentur-Werkzeugs mit tools/
FLIESSBAND_AGENTUR_SKILL=~/.claude/skills/agentur
# Python-Interpreter des Agentur-Werkzeugs
FLIESSBAND_AGENTUR_PYTHON=~/.agentur-werkzeug/venv/bin/python

# === Stimme (ElevenLabs) ===
# Stimmen-ID der eigenen Stimme in ElevenLabs
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
# ELEVENLABS_API_KEY=   (nur Umgebung oder Datei .env.local, nie in .env. Standard: Schlüsselbund elevenlabs-api)

# === WordPress-Mediathek (Upload der Medien für Instagram und Facebook) ===
FLIESSBAND_WP_URL=https://example.com
# Schlüsselbund-Dienst und Konto für das WordPress-Anwendungspasswort
FLIESSBAND_WP_DIENST=fliessband-wp
FLIESSBAND_WP_KONTO=your-wp-user

# === Briefkasten (Server) ===
# Adresse des Briefkastens auf dem Server, für «fliessband briefkasten umstellen»
FLIESSBAND_BRIEFKASTEN_URL=http://your-server-ip:8096
# SSH-Ziel für server/deploy.sh, server/zugang.sh, server/instagram.sh, server/facebook.sh
FLIESSBAND_SERVER=root@your-server-ip
# SSH-Schlüssel für den Server
FLIESSBAND_SSH_KEY=~/.ssh/your_ssh_key

# === Facebook-Seite (nur bei Facebook-Zusatz) ===
# Meta-App-ID (nicht geheim, der App-Geheimcode liegt im Schlüsselbund)
FLIESSBAND_FB_APP_ID=your-meta-app-id
# Name der Facebook-Seite (Teiltreffer, Kleinschreibung egal)
FLIESSBAND_FB_SEITE=your-page-name
# Konto im Schlüsselbund für den App-Geheimcode (Dienst fliessband-facebook-app)
FLIESSBAND_FB_KONTO=fliessband

# === Nur auf dem Server (in /etc/fliessband/konfig.env, nicht lokal) ===
# Bind-Adresse des Dienstes, am besten die Tailscale-IP des Servers. Standard: 127.0.0.1
# FLIESSBAND_HOST=your-tailscale-ip
# Optionale Pfade, Standard passt meist:
# FLIESSBAND_ENV=/etc/fliessband/geheim.env
# FLIESSBAND_DB=/var/lib/fliessband/briefkasten.db
# FLIESSBAND_INSTAGRAM=/var/lib/fliessband/instagram.json
# FLIESSBAND_FACEBOOK=/var/lib/fliessband/facebook.json

# === Geheimnisse im macOS-Schlüsselbund (security add-generic-password) ===
# fliessband-telegram          Telegram-Bot-Token
# fliessband-briefkasten       API-Schlüssel zwischen Mac und Server (fliessband, von server/zugang.sh gesetzt)
# fliessband-facebook-app      App-Geheimcode der Meta-App (Konto: FLIESSBAND_FB_KONTO)
# elevenlabs-api               ElevenLabs-API-Schlüssel
# FLIESSBAND_WP_DIENST         WordPress-Anwendungspasswort (Konto: FLIESSBAND_WP_KONTO)

# --- Nur auf dem Server: /etc/fliessband/geheim.env (root, chmod 640) ---
# TELEGRAM_TOKEN=             Token des Telegram-Bots (von @BotFather)
# CHAT_ID=                    Deine Telegram-Chat-ID (Meldungen und Freigaben)
# API_SCHLUESSEL=             Gemeinsamer Schlüssel Mac <-> Server (server/zugang.sh setzt ihn)
